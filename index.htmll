<!DOCTYPE html>
<html lang="es-AR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Mates y punto | Mates, bombillas y accesorios en Rosario y Funes</title>
<meta name="description" content="Mates, bombillas, bombillones y accesorios en Rosario y Funes. Mirá lo que hay en stock y escribinos por WhatsApp.">
<!-- Tipografía moderna sans-serif (DM Sans) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  /* ===== Variables de diseño (cambiá colores acá) ===== */
  :root {
    --blanco: #ffffff;
    --crema: #f3e9dd;       /* marrón clarito de fondo */
    --crema-oscuro: #e6d5c0;
    --marron: #6b4426;      /* acento para botones */
    --texto: #000000;
    --texto-suave: #4a4038;
    --radio: 10px;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: inherit; }
  html { scroll-behavior: smooth; scroll-padding-top: env(safe-area-inset-top, 0px); }
  body {
    margin: 0; background: var(--blanco); color: var(--texto);
    font-family: "DM Sans", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; line-height: 1.65; font-size: 16px;
  }
  img, svg { max-width: 100%; }
  a { color: inherit; }
  h1, h2, h3 { line-height: 1.2; margin: 0 0 .6em; font-weight: 700; }
  h1 { font-size: clamp(2rem, 5vw, 3.2rem); letter-spacing: -0.02em; }
  h2 { font-size: clamp(1.5rem, 3.5vw, 2.1rem); }
  p { margin: 0 0 1em; }
  .contenedor { width: min(1060px, 100% - 2.5rem); margin-inline: auto; }
  section { padding: 4.5rem 0; }
  .fondo-crema { background: var(--crema); }
  :focus-visible { outline: 3px solid var(--marron); outline-offset: 3px; }

  /* ===== Botones ===== */
  .btn {
    display: inline-block; padding: .85rem 1.5rem; border-radius: var(--radio);
    background: var(--marron); color: #fff; text-decoration: none; font: inherit;
    font-weight: 700; border: 0; cursor: pointer; transition: transform .2s, background .2s;
  }
  .btn:hover { background: #4f3119; transform: translateY(-2px); }
  .btn.secundario { background: transparent; color: var(--texto); border: 2px solid var(--texto); }
  .btn.secundario:hover { background: var(--texto); color: #fff; }

  /* ===== Encabezado ===== */
  header { background: var(--blanco); border-bottom: 1px solid var(--crema-oscuro); }
  .barra { display: flex; justify-content: space-between; align-items: center; padding: 1rem 0; gap: 1rem; }
  .marca { display: inline-flex; align-items: center; gap: .6rem; font-weight: 700; font-size: 1.2rem; letter-spacing: -0.02em; text-decoration: none; }
  .marca svg { width: 38px; height: 38px; flex: none; }
  .marca .punto { color: var(--marron); }
  nav { display: flex; gap: 1.2rem; flex-wrap: wrap; font-size: .92rem; }
  nav a { text-decoration: none; }
  nav a:hover { text-decoration: underline; }

  /* ===== Hero ===== */
  .hero { background: var(--crema); padding: 5rem 0; }
  .hero-centro { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .logo-grande { width: 130px; height: 130px; }
  .logo-nombre { margin: 1rem 0 .5rem; font-size: clamp(2.2rem, 6vw, 3.4rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; }
  .logo-nombre .punto { color: var(--marron); }
  .hero h1 { font-size: clamp(1.05rem, 2.6vw, 1.4rem); font-weight: 400; letter-spacing: 0; margin: 0; }

  /* ===== Beneficios ===== */
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .beneficio { text-align: center; padding: 1rem; }
  .icono {
    width: 64px; height: 64px; margin: 0 auto 1rem; border-radius: 50%;
    background: var(--crema); display: grid; place-items: center;
  }
  .icono svg { width: 30px; height: 30px; stroke: var(--marron); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  /* ===== Productos ===== */
  .filtros { display: flex; gap: .5rem; flex-wrap: wrap; margin: 1.2rem 0 1.8rem; }
  .filtros.sub { margin-top: -.8rem; }
  .filtros.sub:empty { display: none; }
  .filtro {
    font: inherit; font-size: .9rem; padding: .45rem 1rem; border-radius: 999px; cursor: pointer;
    background: var(--blanco); border: 1px solid var(--crema-oscuro); transition: background .2s;
  }
  .filtro[aria-pressed="true"] { background: var(--texto); color: #fff; border-color: var(--texto); }
  .productos { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 1.2rem; }
  .producto {
    background: var(--blanco); border-radius: var(--radio); padding: 1.2rem;
    display: flex; flex-direction: column; gap: .4rem;
  }
  .producto .foto { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 8px; background: var(--crema); display: block; }
  .producto .minis { display: flex; gap: .4rem; }
  .producto .mini { width: 44px; height: 44px; padding: 0; border: 2px solid transparent; border-radius: 6px; overflow: hidden; cursor: pointer; background: none; }
  .producto .mini[aria-current="true"] { border-color: var(--marron); }
  .producto .mini img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .producto h3 { font-size: 1rem; margin: .5rem 0 0; }
  .producto .detalle { font-size: .88rem; color: var(--texto-suave); margin: 0; flex: 1; }
  .producto .pie { display: flex; justify-content: space-between; align-items: center; gap: .5rem; margin-top: .5rem; }
  .precio { font-weight: 700; }
  .stock { font-size: .8rem; color: var(--texto-suave); }
  .stock.agotado { text-decoration: line-through; }
  .producto .btn { padding: .55rem 1rem; font-size: .85rem; text-align: center; }
  .nota { font-size: .85rem; color: var(--texto-suave); margin-top: 1.5rem; }

  /* ===== Sobre nosotros ===== */
  .nosotros { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: center; }
  .nosotros .caja { background: var(--crema); border-radius: var(--radio); padding: 2rem; }
  .nosotros ul { margin: 0; padding-left: 1.2rem; }

  /* ===== Contacto ===== */
  .contacto-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 2.5rem; }
  form { background: var(--blanco); padding: 1.8rem; border-radius: var(--radio); }
  label { display: block; font-size: .9rem; font-weight: 700; margin-bottom: .3rem; }
  input, select, textarea {
    width: 100%; font: inherit; padding: .7rem .8rem; margin-bottom: 1rem; color: #000;
    border: 1px solid var(--crema-oscuro); border-radius: 8px; background: #fff;
  }
  textarea { min-height: 110px; resize: vertical; }
  .error { color: #8b1a1a; font-size: .85rem; margin: -.6rem 0 1rem; min-height: 1em; }

  /* ===== Footer ===== */
  footer { background: var(--texto); color: #fff; padding: 2.5rem 0; }
  .footer-grid { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; align-items: center; }
  .redes { display: flex; gap: 1rem; flex-wrap: wrap; }
  .redes a { text-decoration: none; border-bottom: 1px solid rgba(255,255,255,.4); }
  .redes a:hover { border-color: #fff; }
  footer small { color: #cfc6bb; }

  /* ===== Animaciones al hacer scroll ===== */
  .reveal { opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s ease; }
  .reveal.visible { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .reveal { opacity: 1; transform: none; transition: none; }
    .btn { transition: none; }
  }

  /* ===== Responsive ===== */
  @media (max-width: 800px) {
    section { padding: 3rem 0; }
    .nosotros, .contacto-grid, .grid-3 { grid-template-columns: 1fr; }
    .logo-grande { width: 96px; height: 96px; }
  }
</style>
</head>
<body>

<!-- ===== ENCABEZADO ===== -->
<header>
  <div class="contenedor barra">
    <!-- Logo: isotipo de mate con bombilla + nombre -->
    <a class="marca" href="#inicio" aria-label="Mates y punto, inicio">
      <svg viewBox="0 0 40 40" aria-hidden="true">
        <rect width="40" height="40" rx="11" fill="#6b4426"/>
        <path d="M11 17h18c0 9-4 13-9 13s-9-4-9-13z" fill="#fff"/>
        <path d="M21 17L29 7" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/>
        <circle cx="30" cy="6" r="2.2" fill="#f3e9dd"/>
      </svg>
      <span>mates y punto<span class="punto">.</span></span>
    </a>
    <nav aria-label="Principal">
      <a href="#productos">Productos</a>
      <a href="#nosotros">Nosotros</a>
      <a href="#contacto">Contacto</a>
    </nav>
  </div>
</header>

<main>
<!-- ===== 1. HERO ===== -->
<section class="hero" id="inicio">
  <div class="contenedor hero-centro reveal">
    <!-- Logo grande -->
    <svg class="logo-grande" viewBox="0 0 40 40" role="img" aria-label="Mates y punto">
      <rect width="40" height="40" rx="11" fill="#6b4426"/>
      <path d="M11 17h18c0 9-4 13-9 13s-9-4-9-13z" fill="#fff"/>
      <path d="M21 17L29 7" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/>
      <circle cx="30" cy="6" r="2.2" fill="#f3e9dd"/>
    </svg>
    <p class="logo-nombre">mates y punto<span class="punto">.</span></p>
    <h1>Tu mate de todos los días, bien elegido</h1>
  </div>
</section>

<!-- ===== 2. BENEFICIOS ===== -->
<section id="beneficios">
  <div class="contenedor">
    <h2 class="reveal" style="text-align:center">Por qué comprar con nosotros</h2>
    <div class="grid-3">
      <div class="beneficio reveal">
        <div class="icono"><svg viewBox="0 0 24 24"><path d="M12 2l2.6 6 6.4.6-4.9 4.3 1.5 6.3L12 15.8 6.4 19.2l1.5-6.3L3 8.6 9.4 8z"/></svg></div>
        <h3>Calidad que se nota</h3>
        <p>Elegimos cada mate y cada bombilla pensando en que te duren y se disfruten.</p>
      </div>
      <div class="beneficio reveal">
        <div class="icono"><svg viewBox="0 0 24 24"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg></div>
        <h3>Entrega en tu zona</h3>
        <p>Coordinamos envío o retiro en Rosario, Funes y alrededores.</p>
      </div>
      <div class="beneficio reveal">
        <div class="icono"><svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"/></svg></div>
        <h3>Atención personalizada</h3>
        <p>Te ayudamos a elegir por WhatsApp, rápido y sin vueltas.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== PRODUCTOS EN STOCK =====
     Para actualizar el stock editá la lista "PRODUCTOS" en el script del final. -->
<section class="fondo-crema" id="productos">
  <div class="contenedor">
    <h2 class="reveal">Productos en stock</h2>
    <p class="reveal">Filtrá por categoría y consultá por el que te guste.</p>
    <div class="filtros reveal" id="filtros" role="group" aria-label="Filtrar por categoría"></div>
    <div class="filtros sub" id="subfiltros" role="group" aria-label="Filtrar mates por tipo"></div>
    <div class="productos" id="productos-lista"></div>
    <p class="nota reveal">Los precios y el stock pueden cambiar. Confirmá disponibilidad por WhatsApp.</p>
  </div>
</section>

<!-- ===== 3. SOBRE NOSOTROS ===== -->
<section id="nosotros">
  <div class="contenedor nosotros">
    <div class="reveal">
      <h2>Sobre nosotros</h2>
      <p>En Mates y punto nos gusta el mate tanto como a vos. Somos un negocio de Rosario que reúne mates, bombillas, bombillones y accesorios para quienes toman mate todos los días y para quienes buscan un regalo.</p>
      <p>Trabajamos con trato cercano: te contamos las diferencias entre cada producto y te recomendamos lo que mejor se adapta a tu manera de tomar.</p>
    </div>
    <div class="caja reveal">
      <h3>Lo que vas a encontrar</h3>
      <ul>
        <li>Mates de distintos materiales y estilos</li>
        <li>Bombillas y bombillones</li>
        <li>Accesorios para el mate</li>
        <li>Ideas para regalar</li>
      </ul>
    </div>
  </div>
</section>

<!-- ===== 4. FORMULARIO DE CONTACTO ===== -->
<section class="fondo-crema" id="contacto">
  <div class="contenedor contacto-grid">
    <div class="reveal">
      <h2>Contanos qué estás buscando</h2>
      <p>Completá el formulario y se abre WhatsApp con tu mensaje listo para enviar. Te respondemos a la brevedad.</p>
      <p><a class="btn secundario" href="#" data-wa="Hola! Quiero hacer una consulta.">Prefiero escribir directo</a></p>
    </div>
    <form id="form-contacto" class="reveal" novalidate>
      <label for="nombre">Nombre</label>
      <input id="nombre" name="nombre" type="text" autocomplete="name" required>
      <div class="error" id="err-nombre"></div>

      <label for="zona">Zona</label>
      <select id="zona" name="zona">
        <option>Rosario</option>
        <option>Funes</option>
        <option>Otra localidad</option>
      </select>

      <label for="mensaje">¿Qué te interesa?</label>
      <textarea id="mensaje" name="mensaje" placeholder="Ej: busco un mate imperial y una bombilla de acero" required></textarea>
      <div class="error" id="err-mensaje"></div>

      <button class="btn" type="submit">Enviar por WhatsApp</button>
    </form>
  </div>
</section>
</main>

<!-- ===== 6. FOOTER ===== -->
<footer>
  <div class="contenedor footer-grid">
    <div>
      <strong>Mates y punto</strong><br>
      <small>Rosario · Funes y alrededores</small>
    </div>
    <div class="redes">
      <!-- Redes: agregá más links acá si querés -->
      <a href="#" data-wa="Hola! Quiero hacer una consulta.">WhatsApp</a>
      <a href="https://www.instagram.com/joakocabreraa_" target="_blank" rel="noopener">Instagram</a>
    </div>
    <small>© <span id="anio"></span> Mates y punto</small>
  </div>
</footer>

<script>
  /* ===== CONFIGURACIÓN ===== */
  // Número de WhatsApp con código de país y área, sin + ni espacios.
  const WHATSAPP = "5493417291100"; // 549 + 341 (Rosario) + número, sin 0 ni 15

  // Lista de productos. "sub": subcategoría de los mates (Imperiales, Torpedos, Algarrobo). "fotos": 1 o más imágenes; "stock": false lo muestra como agotado y "consultar" como "Consultar stock".
  const PRODUCTOS = [
    { nombre: "Imperial premium", categoria: "Mates", sub: "Imperiales", fotos: ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], detalle: "", precio: "$43.000", stock: true },
    { nombre: "Imperial clásico", categoria: "Mates", sub: "Imperiales", fotos: ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], detalle: "", precio: "$30.000", stock: true },
    { nombre: "Imperial rey", categoria: "Mates", sub: "Imperiales", fotos: ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], detalle: "", precio: "$42.000", stock: true },
    { nombre: "Imperial avejentado", categoria: "Mates", sub: "Imperiales", fotos: ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], detalle: "", precio: "$42.000", stock: true },
    { nombre: "Imperial animal print C/B", categoria: "Mates", sub: "Imperiales", fotos: ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], detalle: "", precio: "$43.000", stock: true },
    { nombre: "Imperial animal print", categoria: "Mates", sub: "Imperiales", fotos: ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], detalle: "", precio: "$43.000", stock: true },
    { nombre: "Camionero de algarrobo", categoria: "Mates", sub: "Algarrobo", fotos: ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], detalle: "", precio: "$26.000", stock: true },
    { nombre: "Camionero de madera laqueado", categoria: "Mates", sub: "Algarrobo", fotos: ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], detalle: "", precio: "$21.000", stock: true },
    { nombre: "Imperial de algarrobo", categoria: "Mates", sub: "Algarrobo", fotos: ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], detalle: "", precio: "$27.000", stock: true },
    { nombre: "Torpedo premium (Borravino)", categoria: "Mates", sub: "Torpedos", fotos: ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], detalle: "", precio: "$43.000", stock: "consultar" },
    { nombre: "Torpedo premium (Negro)", categoria: "Mates", sub: "Torpedos", fotos: ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], detalle: "", precio: "$43.000", stock: "consultar" },
    { nombre: "Torpedo cincelado", categoria: "Mates", sub: "Torpedos", fotos: ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], detalle: "", precio: "$39.000", stock: true },
    { nombre: "Torpedo avejentado joyero", categoria: "Mates", sub: "Torpedos", fotos: ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], detalle: "", precio: "$43.000", stock: true },
    { nombre: "Bombillón rey", categoria: "Bombillones", fotos: ["data:image/jpeg;base64,"], detalle: "", precio: "$22.000", stock: true },
    { nombre: "Bombillón pico de loro", categoria: "Bombillones", fotos: ["data:image/jpeg;base64,"], detalle: "", precio: "$22.000", stock: true },
    { nombre: "Bombillón trenzado", categoria: "Bombillones", fotos: ["data:image/jpeg;base64,"], detalle: "", precio: "$22.000", stock: true },
    { nombre: "Bombillón recto", categoria: "Bombillones", fotos: ["data:image/jpeg;base64,"], detalle: "", precio: "$22.000", stock: true },
    { nombre: "Bombilla pico de loro", categoria: "Bombillas", fotos: ["data:image/jpeg;base64,"], detalle: "", precio: "$6.000", stock: true }
  ];

  /* ===== UTILIDADES ===== */
  // Devuelve el link de WhatsApp con un mensaje ya escrito
  const linkWA = (texto) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(texto)}`;

  // Todos los elementos con data-wa abren WhatsApp con ese mensaje
  document.querySelectorAll("[data-wa]").forEach((el) => {
    el.href = linkWA(el.dataset.wa);
    el.target = "_blank";
    el.rel = "noopener";
  });

  document.getElementById("anio").textContent = new Date().getFullYear();

  /* ===== CATÁLOGO ===== */
  const lista = document.getElementById("productos-lista");
  const contFiltros = document.getElementById("filtros");
  const categorias = ["Todos", ...new Set(PRODUCTOS.map((p) => p.categoria))];
  const contSub = document.getElementById("subfiltros");
  const subcategorias = ["Todos los mates", "Imperiales", "Torpedos", "Algarrobo"];
  let activa = "Todos";
  let subActiva = "Todos los mates";

  function pintarProductos() {
    lista.innerHTML = "";
    PRODUCTOS.filter((p) => (activa === "Todos" || p.categoria === activa) && (activa !== "Mates" || subActiva === "Todos los mates" || p.sub === subActiva)).forEach((p) => {
      const art = document.createElement("article");
      art.className = "producto reveal";
      art.innerHTML = `
        <img class="foto" src="${p.fotos[0]}" alt="${p.nombre}" loading="lazy">
        ${p.fotos.length > 1 ? `<div class="minis">${p.fotos.map((f, i) => `<button class="mini" type="button" aria-label="Ver foto ${i + 1} de ${p.nombre}" aria-current="${i === 0}"><img src="${f}" alt=""></button>`).join("")}</div>` : ""}
        <h3>${p.nombre}</h3>
        <p class="detalle">${p.detalle}</p>
        <div class="pie">
          <span class="precio">${p.precio}</span>
          <span class="stock ${p.stock === false ? "agotado" : ""}">${p.stock === true ? "En stock" : p.stock === false ? "Sin stock" : "Consultar stock"}</span>
        </div>
        <a class="btn" target="_blank" rel="noopener" href="${linkWA(`Hola! Me interesa: ${p.nombre}. ¿Lo tienen disponible?`)}">Consultar</a>`;
      // Miniaturas: cambian la foto principal
      const principal = art.querySelector(".foto");
      art.querySelectorAll(".mini").forEach((b, i) => b.addEventListener("click", () => {
        principal.src = p.fotos[i];
        art.querySelectorAll(".mini").forEach((o) => o.setAttribute("aria-current", o === b));
      }));
      lista.appendChild(art);
      observador.observe(art);
    });
  }

  // Crea una fila de botones de filtro
  function pintarFila(cont, opciones, seleccion, alElegir) {
    cont.innerHTML = "";
    opciones.forEach((o) => {
      const b = document.createElement("button");
      b.className = "filtro";
      b.type = "button";
      b.textContent = o;
      b.setAttribute("aria-pressed", o === seleccion);
      b.addEventListener("click", () => alElegir(o));
      cont.appendChild(b);
    });
  }

  function pintarFiltros() {
    // Fila principal: Todos, Mates, Bombillones, Bombillas
    pintarFila(contFiltros, categorias, activa, (c) => { activa = c; subActiva = "Todos los mates"; pintarFiltros(); pintarProductos(); });
    // Segunda fila (solo dentro de Mates): Imperiales, Torpedos, Algarrobo
    if (activa === "Mates") {
      pintarFila(contSub, subcategorias, subActiva, (s) => { subActiva = s; pintarFiltros(); pintarProductos(); });
    } else {
      contSub.innerHTML = "";
    }
  }

  /* ===== ANIMACIONES AL HACER SCROLL ===== */
  const observador = new IntersectionObserver((entradas) => {
    entradas.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add("visible"); observador.unobserve(e.target); }
    });
  }, { threshold: 0.12 });

  pintarFiltros();
  pintarProductos();
  document.querySelectorAll(".reveal").forEach((el) => observador.observe(el));

  /* ===== FORMULARIO → WHATSAPP ===== */
  document.getElementById("form-contacto").addEventListener("submit", (ev) => {
    ev.preventDefault();
    const nombre = document.getElementById("nombre").value.trim();
    const zona = document.getElementById("zona").value;
    const mensaje = document.getElementById("mensaje").value.trim();

    // Validación simple
    document.getElementById("err-nombre").textContent = nombre ? "" : "Escribí tu nombre.";
    document.getElementById("err-mensaje").textContent = mensaje ? "" : "Contanos qué estás buscando.";
    if (!nombre || !mensaje) return;

    const texto = `Hola! Soy ${nombre} (${zona}). ${mensaje}`;
    window.open(linkWA(texto), "_blank", "noopener");
  });
</script>
</body>
</html>
